<?xml version="1.0" encoding="utf-8"?>
<!-- Android cloud backup and device transfer (API 31+): everything except the AI and search keys. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="ai_key" />
        <exclude domain="file" path="ai_search_key" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="ai_key" />
        <exclude domain="file" path="ai_search_key" />
    </device-transfer>
</data-extraction-rules>
